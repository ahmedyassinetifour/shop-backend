        {
          "name": "List active categories",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Public categories return active category data', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const categories = pm.response.json();",
                  "  pm.expect(categories).to.be.an('array');",
                  "  pm.expect(categories.length).to.be.greaterThan(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
