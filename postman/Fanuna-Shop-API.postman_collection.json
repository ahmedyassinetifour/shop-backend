              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set('testProductName', 'Postman Product ' + Date.now());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Create product returns an expected status', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([201, 400, 401]);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  const product = pm.response.json();",
                  "  pm.environment.set('testProductId', product.id);",
                  "  pm.test('Product links to the selected category', function () {",
                  "    pm.expect(product.category_id).to.eql(pm.environment.get('testCategoryId'));",
                  "    pm.expect(product.category).to.eql(pm.environment.get('testCategoryName'));",
                  "  });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
