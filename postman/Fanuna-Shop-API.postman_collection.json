  "item": [
    {
      "name": "Auth & JWT",
      "item": [
        {
          "name": "Register account",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.environment.get('testEmail')) {",
                  "  pm.environment.set('testEmail', 'fanuna.postman.test+' + Date.now() + '@example.com');",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Registration returns an expected status', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([201, 400, 409]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "id": "503714fc-9aa2-455b-a56e-ab61adb880aa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Postman Test User\",\"email\":\"{{testEmail}}\",\"password\":\"{{testPassword}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "One request for registration cases. Valid name/email/password → 201. Resend the same email → 409. Edit the body to omit a field or use an invalid email/password → 400."
          },
          "response": [],
          "createdAt": "2026-11-09T00:44:11.000Z",
          "updatedAt": "2026-11-09T00:50:46.000Z",
          "uid": "29019193-503714fc-9aa2-455b-a56e-ab61adb880aa"
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login returns an expected status', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 400, 401, 429]);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.user).not.to.have.property('passwordHash');",
                  "  pm.environment.set('authToken', body.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "id": "9f609442-d92e-4938-ae79-709b7e90be98",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{testEmail}}\",\"password\":\"{{testPassword}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "One request for login cases. Correct credentials → 200 and saves authToken. Change the password → 401. Remove a field → 400. Repeated attempts can demonstrate the login rate limit (429)."
          },
          "response": [],
          "createdAt": "2026-11-09T00:44:38.000Z",
          "updatedAt": "2026-11-09T00:50:53.000Z",
          "uid": "29019193-9f609442-d92e-4938-ae79-709b7e90be98"
        }
